## Copy this file to `.env.local` and fill in your real key.
## IMPORTANT: Do not commit `.env.local` (CRA ignores it by default).

# Your Gemini API key (required)
REACT_APP_API_KEY=your_api_key_here

# Option A: Direct endpoint (recommended to avoid version mismatch errors)
# Use v1 for gemini-1.5-flash to ensure generateContent support
REACT_APP_API_URL=https://generativelanguage.googleapis.com/v1/models/gemini-1.5-flash:generateContent

# Option B: Let the app build the URL automatically
# REACT_APP_GEMINI_VERSION=v1
# REACT_APP_GEMINI_MODEL=gemini-1.5-flash

# Notes:
# - Do NOT wrap values in backticks.
# - Avoid extra spaces around the '=' sign.
# - Restart `npm start` after any .env change.
